# The app's connection. This MUST be the cairn_app role, which cannot bypass
# row level security. A superuser or a role with BYPASSRLS makes every privacy
# and authorship policy in Cairn decorative, and it fails silently. The app
# refuses to serve a request over such a connection rather than serve one
# member another member's private items.
DATABASE_URL=postgres://cairn_app:PASSWORD@HOST:6543/postgres

# The owner connection. Migrations only, never a request path.
DIRECT_URL=postgres://postgres:PASSWORD@HOST:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=

# The publishable key, from Supabase, Settings, API Keys, on the "Publishable and
# secret API keys" tab. It begins sb_publishable_. The legacy anon JWT, on the
# other tab, still works and goes in the same place.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Not needed, and deliberately absent. Cairn never uses a key that can bypass
# row level security: not the secret key, not service_role. Authorization is
# enforced by the database against the cairn_app role, so there is nothing in a
# request path that could hold one.

# Server only. Phase 4 onward.
ANTHROPIC_API_KEY=

# Guards /api/cron/*
CRON_SECRET=
