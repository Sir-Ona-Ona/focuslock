# The app's connection. This MUST be the cairn_app role, which cannot bypass
# row level security. A superuser or a role with BYPASSRLS makes every privacy
# and authorship policy in Cairn decorative, and it fails silently. The app
# refuses to serve a request over such a connection rather than serve one
# member another member's private items.
DATABASE_URL=postgres://cairn_app:PASSWORD@HOST:6543/postgres

# The owner connection. Migrations only, never a request path.
DIRECT_URL=postgres://postgres:PASSWORD@HOST:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Migrations and cron only. Never in a request path.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Phase 4 onward.
ANTHROPIC_API_KEY=

# Guards /api/cron/*
CRON_SECRET=
